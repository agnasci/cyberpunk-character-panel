<section class="ccp-actions">
  {{#if hasSubject}}
  {{#if actions.favorites.length}}
  <div class="ccp-favs" role="group" aria-label="{{localize 'CCP.Skills.Favorites'}}">
    <i class="fa-solid fa-star ccp-favs-tag" aria-hidden="true" data-tooltip="{{localize 'CCP.Skills.Favorites'}}"></i>
    {{#each actions.favorites}}
    <button type="button" id="ccp-fav-{{id}}" class="ccp-fav" data-action="rollSkill" data-skill-id="{{id}}" {{#unless ../canEdit}}disabled{{/unless}}><span>{{label}}</span><b>{{total}}</b></button>
    {{/each}}
  </div>
  {{/if}}
  <nav class="ccp-tabs" aria-label="{{localize 'CCP.Panel.Sections'}}">
    {{#if actions.hasSkills}}
    <button type="button" id="ccp-key-skills" class="ccp-tab" data-action="toggleDrawer" data-drawer="skills" aria-expanded="{{#if (eq actions.open 'skills')}}true{{else}}false{{/if}}" aria-controls="ccp-drawer" data-tooltip="{{localize 'CCP.Drawer.Skills'}}"><i class="fa-solid fa-list-check" aria-hidden="true"></i><span>{{localize "CCP.Drawer.Skills"}}</span></button>
    {{/if}}
    {{#if actions.hasRoles}}
    <button type="button" id="ccp-key-roles" class="ccp-tab" data-action="toggleDrawer" data-drawer="roles" aria-expanded="{{#if (eq actions.open 'roles')}}true{{else}}false{{/if}}" aria-controls="ccp-drawer" data-tooltip="{{localize 'CCP.Drawer.Roles'}}"><i class="fa-solid fa-id-badge" aria-hidden="true"></i><span>{{localize "CCP.Drawer.Roles"}}</span></button>
    {{/if}}
    {{#if actions.hasNet}}
    <button type="button" id="ccp-key-net" class="ccp-tab" data-action="toggleDrawer" data-drawer="net" aria-expanded="{{#if (eq actions.open 'net')}}true{{else}}false{{/if}}" aria-controls="ccp-drawer" data-tooltip="{{localize 'CCP.Drawer.Net'}}"><i class="fa-solid fa-network-wired" aria-hidden="true"></i><span>{{localize "CCP.Drawer.Net"}}</span></button>
    {{/if}}
    {{#if actions.hasSheet}}
    <button type="button" id="ccp-key-sheet" class="ccp-tab" data-action="toggleDrawer" data-drawer="sheet" aria-expanded="{{#if (eq actions.open 'sheet')}}true{{else}}false{{/if}}" aria-controls="ccp-drawer" data-tooltip="{{localize 'CCP.Drawer.Sheet'}}"><i class="fa-solid fa-wallet" aria-hidden="true"></i><span>{{localize "CCP.Drawer.Sheet"}}</span></button>
    {{/if}}
    <button type="button" id="ccp-key-health" class="ccp-tab" data-action="toggleDrawer" data-drawer="health" aria-expanded="{{#if (eq actions.open 'health')}}true{{else}}false{{/if}}" aria-controls="ccp-drawer" data-tooltip="{{localize 'CCP.Drawer.Health'}}"><i class="fa-solid fa-kit-medical" aria-hidden="true"></i><span>{{localize "CCP.Drawer.Health"}}</span></button>
    {{#if canEdit}}
    <button type="button" id="ccp-key-facedown" class="ccp-tab ccp-tab-roll" data-action="rollFacedown" data-tooltip="{{localize 'CPR.characterSheet.bottomPane.fight.facedown'}}"><i class="fa-solid fa-dice-d10" aria-hidden="true"></i><span>{{localize "CCP.Drawer.Facedown"}}</span></button>
    {{/if}}
  </nav>
  {{/if}}
</section>
