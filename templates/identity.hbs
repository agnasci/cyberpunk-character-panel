<section class="ccp-identity">
  {{#if hasSubject}}
  <button type="button" class="ccp-portrait" data-action="openSheet" aria-label="{{localize 'CCP.Panel.OpenSheet'}}" data-tooltip="{{localize 'CCP.Panel.OpenSheet'}}" data-tooltip-direction="UP">
    <img src="{{identity.img}}" alt="">
  </button>
  <header class="ccp-id">
    <div class="ccp-name"{{#if identity.alias}} data-tooltip="{{identity.alias}}"{{/if}}>{{identity.name}}</div>
    {{#if identity.alias}}<span class="ccp-alias">{{identity.alias}}</span>{{/if}}
    {{#if identity.role}}<span class="ccp-role"><span>{{identity.role.name}}</span><b>{{identity.role.rank}}</b></span>{{/if}}
  </header>
  {{/if}}
</section>
